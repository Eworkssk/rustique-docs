---
import { cargo, defaultFeatures, featureDefs } from '../../data/landing';
const f = defaultFeatures;
const c = cargo(f);
---
<section class="wrap" style="max-width: 1280px; margin: 0 auto; padding: 136px 32px 0" data-features>
<div style="display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start">
<div style="flex: 5 1 360px; min-width: 0">
<h2 class="mono" style="margin: 0; font-size: clamp(26px, 3vw, 40px); line-height: 1.15; font-weight: 700; text-wrap: balance">Flip the bits you need.</h2>
<p style="margin: 20px 0 0; max-width: 50ch; color: #3C4756; text-wrap: pretty">Default features cover both databases with TLS through rustls. MySQL only? Drop Oracle and the Instant Client goes with it. Requires Rust 1.88 or newer.</p>
</div>
<div style="flex: 7 1 520px; min-width: 0">
<div class="mono" style="display: flex; justify-content: space-between; align-items: baseline; font-size: 12px; color: #3C4756; padding-bottom: 8px"><span>features: u8</span><span data-binary style="font-size: 16px; color: #10161F; font-weight: 700; font-variant-numeric: tabular-nums">{c.binary}</span></div>
<div role="group" aria-label="Cargo features" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); border: 1px solid #10161F; background: #F3F5F7">
{featureDefs.map(([key, idx, name, desc]) => (
<button type="button" class={f[key] ? 'bit on' : 'bit'} aria-pressed={String(f[key])} data-bit={key}>
<span class="mono" style="font-size: 11.5px; color: #3C4756">bit {idx} · <span data-state>{f[key] ? '1' : '0'}</span></span>
<span class="mono" style="font-size: 14px; font-weight: 700">{name}</span>
<span>{desc}</span>
</button>
))}
</div>
<div class="mono" style="margin-top: 16px; background: #10161F; color: #E8ECF1; border: 1px solid #10161F">
<div style="display: flex; justify-content: space-between; align-items: center; padding: 0 0 0 16px; border-bottom: 1px solid #2A3442; font-size: 12px; color: #8A96A6"><span>Cargo.toml</span><button class="copy" type="button" data-copy={c.text} aria-label="Copy dependency lines">Copy</button></div>
<div class="scrollx" style="padding: 16px 20px; font-size: 13px; line-height: 1.8">
<div class="cl"><span class="m">[dependencies]</span></div>
<div class="cl"><span class="s" data-line>{c.line}</span></div>
<div class="cl"><span class="p">tokio = &#123; version = "1", features = ["macros", "rt-multi-thread"] &#125;</span></div>
<div class="cl"><span class="p">chrono = "0.4"</span></div>
</div>
</div>
<p data-note style="margin: 12px 0 0; font-size: 14px; color: #3C4756">{c.note}</p>
</div>
</div>
</section>

<script>
  import { cargo, defaultFeatures, toggleFeature, type FeatureKey } from '../../data/landing';

  const root = document.querySelector<HTMLElement>('[data-features]')!;
  let f = defaultFeatures;
  root.querySelectorAll<HTMLButtonElement>('[data-bit]').forEach((btn) =>
    btn.addEventListener('click', () => {
      f = toggleFeature(f, btn.dataset.bit as FeatureKey);
      root.querySelectorAll<HTMLButtonElement>('[data-bit]').forEach((b) => {
        const on = f[b.dataset.bit as FeatureKey];
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
        b.querySelector('[data-state]')!.textContent = on ? '1' : '0';
      });
      const c = cargo(f);
      root.querySelector('[data-binary]')!.textContent = c.binary;
      root.querySelector('[data-line]')!.textContent = c.line;
      root.querySelector('[data-note]')!.textContent = c.note;
      root.querySelector<HTMLElement>('[data-copy]')!.dataset.copy = c.text;
    }),
  );
</script>
